ENVIRONMENT=development
RMP_SERVICE_TOKEN=replace-with-a-long-random-token
REDIS_URL=redis://redis:6379/0

# Set this to the RMP school ID returned by /api/v1/schools/search.
# For the target application, choose the correct Texas A&M campus result.
PRIMARY_SCHOOL_ID=

ALLOWED_ORIGINS=
DOCS_ENABLED=true
RMP_TIMEOUT_SECONDS=8
REQUEST_LIMIT_PER_MINUTE=120
MAX_UPSTREAM_CONCURRENCY=5
SCHOOL_CACHE_SECONDS=86400
PROFESSOR_SEARCH_CACHE_SECONDS=900
PROFESSOR_PROFILE_CACHE_SECONDS=3600
EMPTY_CACHE_SECONDS=60
STALE_CACHE_SECONDS=86400
